{
  "_comment": "Harness settings. Local mode is the default and the only required mode. Paths are relative to the project root.",
  "mode": "local",
  "ollama_url": "http://127.0.0.1:11434",
  "model": "gemma4:e2b-it-qat",
  "embed_model": "embeddinggemma",
  "num_ctx": 8192,
  "keep_alive": "15m",
  "temperature": {
    "ask": 0.1,
    "chat": 0.6,
    "ingest": 0.2
  },
  "chunk_chars": 1200,
  "chunk_overlap_chars": 150,
  "top_k": 10,
  "max_passages_per_file": 6,
  "ask_context_chars": 8000,
  "ingest_source_chars": 8000,
  "chat_history_turns": 6,
  "chat_history_chars": 6000,
  "paths": {
    "vault": "vault",
    "raw": "vault/raw",
    "wiki": "vault/wiki",
    "index_md": "vault/index.md",
    "catalog_md": "vault/Source Catalog.md",
    "plan": "config/wiki_plan.json",
    "instructions": "instructions",
    "state": "state",
    "runs": "runs",
    "drafts": "outputs/drafts"
  }
}
